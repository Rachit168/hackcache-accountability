# Copy to .env in D:/project/Hack Cache. Use a NEW dedicated hackathon project.
PORT=3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=
# Exact project ref again, explicitly confirming this project is dedicated.
DEDICATED_PROJECT_CONFIRM=
# Runtime login must be hc_runtime (pooler: hc_runtime.PROJECT_REF).
DATABASE_URL=
# Used only by npm run db:migrate; never by the web server.
MIGRATION_DATABASE_URL=
# Optional private staging: enter the original database password here, then
# npm run setup:database constructs an encoded MIGRATION_DATABASE_URL locally.
HC_MIGRATION_PASSWORD=
HC_RUNTIME_PASSWORD=
# Integration creates test-owned records and two managed anonymous identities.
RUN_CONNECTED_CHECKS=false
